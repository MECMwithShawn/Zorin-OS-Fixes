#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
set -e

if [ "$1" = "setup" ]
then
    . /usr/share/initramfs-tools/hook-functions
    copy_exec /sbin/mdadm
    copy_exec /sbin/mdmon

    exit 0
fi

mdmon --all --takeover >/dev/null 2>&1
mdadm -vv --wait-clean --scan >/dev/null 2>&1
mdadm -vv --stop --scan >/dev/null 2>&1
