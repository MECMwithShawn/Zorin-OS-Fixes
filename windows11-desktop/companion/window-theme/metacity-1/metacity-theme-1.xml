<?xml version='1.0' encoding='utf-8'?>
<metacity_theme>
  <info>
    <name>Zorin11-Dark</name>
    <author>Zorin Windows 11 desktop project</author>
    <copyright>2026 Zorin Windows 11 desktop project</copyright>
    <date>2026-10-17</date>
    <description>Original flat dark window captions with Windows-style controls.</description>
  </info>
  <frame_geometry name="normal" rounded_top_left="true" rounded_top_right="true">
    <distance name="left_width" value="1" />
    <distance name="right_width" value="1" />
    <distance name="bottom_height" value="1" />
    <distance name="left_titlebar_edge" value="1" />
    <distance name="right_titlebar_edge" value="1" />
    <distance name="button_width" value="46" />
    <distance name="button_height" value="32" />
    <distance name="title_vertical_pad" value="4" />
    <border name="title_border" left="10" right="10" top="0" bottom="0" />
    <border name="button_border" left="0" right="0" top="0" bottom="0" />
  </frame_geometry>
  <frame_geometry name="maximized" parent="normal" rounded_top_left="false" rounded_top_right="false">
    <distance name="left_width" value="0" />
    <distance name="right_width" value="0" />
    <distance name="bottom_height" value="0" />
    <distance name="left_titlebar_edge" value="0" />
    <distance name="right_titlebar_edge" value="0" />
  </frame_geometry>
  <draw_ops name="frame_active">
    <rectangle color="#202020" x="0" y="0" width="width" height="height" filled="true" />
    <rectangle color="#4d4d4d" x="0" y="0" width="width-1" height="height-1" filled="false" />
  </draw_ops>
  <draw_ops name="title_active">
    <icon x="0" y="(height-16)/2" width="16" height="16" />
    <title color="#f5f5f5" x="24" y="(height-title_height)/2" />
  </draw_ops>
  <draw_ops name="close_active_normal">
    <image filename="../controls/close.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="close_active_prelight">
    <rectangle color="#c42b1c" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/close.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="close_active_pressed">
    <rectangle color="#a92518" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/close.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="minimize_active_normal">
    <image filename="../controls/minimize.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="minimize_active_prelight">
    <rectangle color="#383838" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/minimize.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="minimize_active_pressed">
    <rectangle color="#303030" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/minimize.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="maximize_active_normal">
    <image filename="../controls/maximize.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="maximize_active_prelight">
    <rectangle color="#383838" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/maximize.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="maximize_active_pressed">
    <rectangle color="#303030" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/maximize.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="restore_active_normal">
    <image filename="../controls/restore.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="restore_active_prelight">
    <rectangle color="#383838" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/restore.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="restore_active_pressed">
    <rectangle color="#303030" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/restore.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="menu_active_normal">
    <icon x="(width-16)/2" y="(height-16)/2" width="16" height="16" />
  </draw_ops>
  <draw_ops name="menu_active_prelight">
    <rectangle color="#383838" x="0" y="0" width="width" height="height" filled="true" />
    <icon x="(width-16)/2" y="(height-16)/2" width="16" height="16" />
  </draw_ops>
  <draw_ops name="menu_active_pressed">
    <rectangle color="#303030" x="0" y="0" width="width" height="height" filled="true" />
    <icon x="(width-16)/2" y="(height-16)/2" width="16" height="16" />
  </draw_ops>
  <frame_style name="active_normal" geometry="normal">
    <piece position="entire_background" draw_ops="frame_active" />
    <piece position="title" draw_ops="title_active" />
    <button function="close" state="normal" draw_ops="close_active_normal" />
    <button function="close" state="prelight" draw_ops="close_active_prelight" />
    <button function="close" state="pressed" draw_ops="close_active_pressed" />
    <button function="minimize" state="normal" draw_ops="minimize_active_normal" />
    <button function="minimize" state="prelight" draw_ops="minimize_active_prelight" />
    <button function="minimize" state="pressed" draw_ops="minimize_active_pressed" />
    <button function="maximize" state="normal" draw_ops="maximize_active_normal" />
    <button function="maximize" state="prelight" draw_ops="maximize_active_prelight" />
    <button function="maximize" state="pressed" draw_ops="maximize_active_pressed" />
    <button function="menu" state="normal" draw_ops="menu_active_normal" />
    <button function="menu" state="prelight" draw_ops="menu_active_prelight" />
    <button function="menu" state="pressed" draw_ops="menu_active_pressed" />
  </frame_style>
  <frame_style name="active_maximized" geometry="maximized">
    <piece position="entire_background" draw_ops="frame_active" />
    <piece position="title" draw_ops="title_active" />
    <button function="close" state="normal" draw_ops="close_active_normal" />
    <button function="close" state="prelight" draw_ops="close_active_prelight" />
    <button function="close" state="pressed" draw_ops="close_active_pressed" />
    <button function="minimize" state="normal" draw_ops="minimize_active_normal" />
    <button function="minimize" state="prelight" draw_ops="minimize_active_prelight" />
    <button function="minimize" state="pressed" draw_ops="minimize_active_pressed" />
    <button function="maximize" state="normal" draw_ops="restore_active_normal" />
    <button function="maximize" state="prelight" draw_ops="restore_active_prelight" />
    <button function="maximize" state="pressed" draw_ops="restore_active_pressed" />
    <button function="menu" state="normal" draw_ops="menu_active_normal" />
    <button function="menu" state="prelight" draw_ops="menu_active_prelight" />
    <button function="menu" state="pressed" draw_ops="menu_active_pressed" />
  </frame_style>
  <draw_ops name="frame_inactive">
    <rectangle color="#202020" x="0" y="0" width="width" height="height" filled="true" />
    <rectangle color="#333333" x="0" y="0" width="width-1" height="height-1" filled="false" />
  </draw_ops>
  <draw_ops name="title_inactive">
    <icon x="0" y="(height-16)/2" width="16" height="16" />
    <title color="#999999" x="24" y="(height-title_height)/2" />
  </draw_ops>
  <draw_ops name="close_inactive_normal">
    <image filename="../controls/close.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="0.55" />
  </draw_ops>
  <draw_ops name="close_inactive_prelight">
    <rectangle color="#c42b1c" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/close.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="close_inactive_pressed">
    <rectangle color="#a92518" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/close.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="minimize_inactive_normal">
    <image filename="../controls/minimize.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="0.55" />
  </draw_ops>
  <draw_ops name="minimize_inactive_prelight">
    <rectangle color="#383838" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/minimize.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="minimize_inactive_pressed">
    <rectangle color="#303030" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/minimize.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="maximize_inactive_normal">
    <image filename="../controls/maximize.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="0.55" />
  </draw_ops>
  <draw_ops name="maximize_inactive_prelight">
    <rectangle color="#383838" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/maximize.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="maximize_inactive_pressed">
    <rectangle color="#303030" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/maximize.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="restore_inactive_normal">
    <image filename="../controls/restore.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="0.55" />
  </draw_ops>
  <draw_ops name="restore_inactive_prelight">
    <rectangle color="#383838" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/restore.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="restore_inactive_pressed">
    <rectangle color="#303030" x="0" y="0" width="width" height="height" filled="true" />
    <image filename="../controls/restore.svg" x="(width-16)/2" y="(height-16)/2" width="16" height="16" alpha="1" />
  </draw_ops>
  <draw_ops name="menu_inactive_normal">
    <icon x="(width-16)/2" y="(height-16)/2" width="16" height="16" />
  </draw_ops>
  <draw_ops name="menu_inactive_prelight">
    <rectangle color="#383838" x="0" y="0" width="width" height="height" filled="true" />
    <icon x="(width-16)/2" y="(height-16)/2" width="16" height="16" />
  </draw_ops>
  <draw_ops name="menu_inactive_pressed">
    <rectangle color="#303030" x="0" y="0" width="width" height="height" filled="true" />
    <icon x="(width-16)/2" y="(height-16)/2" width="16" height="16" />
  </draw_ops>
  <frame_style name="inactive_normal" geometry="normal">
    <piece position="entire_background" draw_ops="frame_inactive" />
    <piece position="title" draw_ops="title_inactive" />
    <button function="close" state="normal" draw_ops="close_inactive_normal" />
    <button function="close" state="prelight" draw_ops="close_inactive_prelight" />
    <button function="close" state="pressed" draw_ops="close_inactive_pressed" />
    <button function="minimize" state="normal" draw_ops="minimize_inactive_normal" />
    <button function="minimize" state="prelight" draw_ops="minimize_inactive_prelight" />
    <button function="minimize" state="pressed" draw_ops="minimize_inactive_pressed" />
    <button function="maximize" state="normal" draw_ops="maximize_inactive_normal" />
    <button function="maximize" state="prelight" draw_ops="maximize_inactive_prelight" />
    <button function="maximize" state="pressed" draw_ops="maximize_inactive_pressed" />
    <button function="menu" state="normal" draw_ops="menu_inactive_normal" />
    <button function="menu" state="prelight" draw_ops="menu_inactive_prelight" />
    <button function="menu" state="pressed" draw_ops="menu_inactive_pressed" />
  </frame_style>
  <frame_style name="inactive_maximized" geometry="maximized">
    <piece position="entire_background" draw_ops="frame_inactive" />
    <piece position="title" draw_ops="title_inactive" />
    <button function="close" state="normal" draw_ops="close_inactive_normal" />
    <button function="close" state="prelight" draw_ops="close_inactive_prelight" />
    <button function="close" state="pressed" draw_ops="close_inactive_pressed" />
    <button function="minimize" state="normal" draw_ops="minimize_inactive_normal" />
    <button function="minimize" state="prelight" draw_ops="minimize_inactive_prelight" />
    <button function="minimize" state="pressed" draw_ops="minimize_inactive_pressed" />
    <button function="maximize" state="normal" draw_ops="restore_inactive_normal" />
    <button function="maximize" state="prelight" draw_ops="restore_inactive_prelight" />
    <button function="maximize" state="pressed" draw_ops="restore_inactive_pressed" />
    <button function="menu" state="normal" draw_ops="menu_inactive_normal" />
    <button function="menu" state="prelight" draw_ops="menu_inactive_prelight" />
    <button function="menu" state="pressed" draw_ops="menu_inactive_pressed" />
  </frame_style>
  <frame_style_set name="windows">
    <frame focus="yes" state="normal" style="active_normal" resize="both" />
    <frame focus="yes" state="shaded" style="active_normal" />
    <frame focus="yes" state="maximized" style="active_maximized" />
    <frame focus="yes" state="maximized_and_shaded" style="active_maximized" />
    <frame focus="no" state="normal" style="inactive_normal" resize="both" />
    <frame focus="no" state="shaded" style="inactive_normal" />
    <frame focus="no" state="maximized" style="inactive_maximized" />
    <frame focus="no" state="maximized_and_shaded" style="inactive_maximized" />
  </frame_style_set>
  <window type="normal" style_set="windows" />
  <window type="dialog" style_set="windows" />
  <window type="modal_dialog" style_set="windows" />
  <window type="menu" style_set="windows" />
  <window type="utility" style_set="windows" />
  <window type="border" style_set="windows" />
  <menu_icon function="close" state="normal" draw_ops="close_active_normal" />
  <menu_icon function="minimize" state="normal" draw_ops="minimize_active_normal" />
  <menu_icon function="maximize" state="normal" draw_ops="maximize_active_normal" />
  <menu_icon function="unmaximize" state="normal" draw_ops="restore_active_normal" />
</metacity_theme>